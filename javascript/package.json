{
  "name": "acp-sdk-js",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Agent Communication Protocol SDK for JavaScript",
  "author": "IBM Corp.",
  "contributors": [],
  "keywords": [
    "ACP",
    "Agent Communication Protocol",
    "JavaScript"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "require": {
        "types": "./lib/*.d.cts",
        "default": "./lib/*.cjs"
      }
    }
  },
  "files": [
    "lib/**/*",
    "src/**/*",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "cp -r src lib && echo '{\"type\": \"module\"}' > lib/package.json",
    "build:cjs": "babel src --out-dir lib-cjs --presets=@babel/preset-env && echo '{\"type\": \"commonjs\"}' > lib-cjs/package.json",
    "dev": "npm run build -- --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .js,.mjs",
    "lint:fix": "eslint src --ext .js,.mjs --fix",
    "format": "prettier --write src/**/*.js",
    "format:check": "prettier --check src/**/*.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.8",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "eslint": "^9.23.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1"
  },
  "dependencies": {
    "uuid": "^11.1.0",
    "eventsource-parser": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
